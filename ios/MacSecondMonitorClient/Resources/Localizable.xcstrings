    "error.connectFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاتصال بـ %@. تأكد من أن Mac Second Monitor قيد التشغيل على Mac وأن الجهازين على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung mit %@ nicht möglich. Stelle sicher, dass Mac Second Monitor auf dem Mac läuft und sich beide Geräte im selben Netzwerk befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not connect to %@. Make sure Mac Second Monitor is running on the Mac and both devices are on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con %@. Asegúrate de que Mac Second Monitor está abierto en el Mac y de que ambos dispositivos están en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter à %@. Vérifiez que Mac Second Monitor est ouvert sur le Mac et que les deux appareils sont sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi a %@. Assicurati che Mac Second Monitor sia aperto sul Mac e che entrambi i dispositivi siano sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”に接続できませんでした。MacでMac Second Monitorが起動していて、両方のデバイスが同じネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결할 수 없습니다. Mac에서 Mac Second Monitor가 실행 중이고 두 기기가 같은 네트워크에 연결되어 있는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar a %@. Verifique se o Mac Second Monitor está aberto no Mac e se os dois dispositivos estão na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к %@. Убедитесь, что на Mac запущено приложение Mac Second Monitor, а оба устройства находятся в одной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile bağlantı kurulamadı. Mac'te Mac Second Monitor uygulamasının çalıştığından ve iki cihazın aynı ağda olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到“%@”。请确保 Mac 上正在运行 Mac Second Monitor，并且两台设备连接到同一网络。"
          }
        }
      }
    },
