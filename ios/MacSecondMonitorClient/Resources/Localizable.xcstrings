    "connect.nearby.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الشبكة المحلية في الإعدادات للعثور على أجهزة Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den Einstellungen den Zugriff auf das lokale Netzwerk, um Macs zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Local Network access in Settings to find Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la red local en Ajustes para buscar Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès au réseau local dans Réglages pour trouver des Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso alla rete locale in Impostazioni per trovare i Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macを探すには、“設定”でローカルネットワークへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac을 찾으려면 설정에서 로컬 네트워크 접근을 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à Rede Local em Ajustes para encontrar Macs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы найти Mac, разрешите доступ к локальной сети в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'leri bulmak için Ayarlar'dan Yerel Ağ erişimine izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许访问本地网络以查找 Mac。"
          }
        }
      }
    },
    "connect.nearby.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون Mac Second Monitor قيد التشغيل على Mac، وأن يكون الجهازان على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Second Monitor muss auf dem Mac laufen und beide Geräte müssen sich im selben Netzwerk befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Second Monitor must be running on the Mac, and both devices must be on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Second Monitor debe estar abierto en el Mac y ambos dispositivos deben estar en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Second Monitor doit être ouvert sur le Mac et les deux appareils doivent être sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Second Monitor deve essere aperto sul Mac ed entrambi i dispositivi devono essere sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacでMac Second Monitorが起動していて、両方のデバイスが同じネットワークに接続されている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 Mac Second Monitor가 실행 중이어야 하며 두 기기가 같은 네트워크에 연결되어 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac Second Monitor precisa estar aberto no Mac e os dois dispositivos precisam estar na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac должно быть запущено приложение Mac Second Monitor, а оба устройства должны быть в одной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'te Mac Second Monitor çalışıyor olmalı ve iki cihaz aynı ağda bulunmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上必须正在运行 Mac Second Monitor，并且两台设备必须连接到同一网络。"
          }
        }
      }
    },
