    <!-- Errors from the host -->
    <string name="error_permission_missing">Der Mac benötigt die Berechtigung „Bildschirmaufnahme“. Erlaube Mac Second Monitor auf dem Mac unter Systemeinstellungen → Datenschutz &amp; Sicherheit → Bildschirmaufnahme und versuche es dann erneut.</string>
    <string name="error_pairing_failed">Der Kopplungscode war falsch. Versuche es erneut, um einen neuen Code zu erhalten.</string>
    <string name="error_pairing_timeout">Zeitüberschreitung beim Koppeln. Versuche es erneut, um einen neuen Code zu erhalten.</string>
    <string name="error_unsupported_protocol">Diese App und die Mac-App sind nicht kompatibel. Aktualisiere beide auf die neueste Version.</string>
    <string name="error_display_unavailable">Der Mac konnte das Display nicht starten.</string>
    <string name="error_rejected">Der Mac hat die Verbindung abgelehnt.</string>
