    <!-- Errors from the host -->
    <string name="error_permission_missing">Mac에 화면 기록 권한이 필요합니다. Mac의 시스템 설정 → 개인정보 보호 및 보안 → 화면 기록에서 Mac Second Monitor를 허용한 다음 다시 시도하세요.</string>
    <string name="error_pairing_failed">페어링 코드가 올바르지 않습니다. 다시 시도하여 새 코드를 받으세요.</string>
    <string name="error_pairing_timeout">페어링 시간이 초과되었습니다. 다시 시도하여 새 코드를 받으세요.</string>
    <string name="error_unsupported_protocol">이 앱과 Mac 앱이 호환되지 않습니다. 둘 다 최신 버전으로 업데이트하세요.</string>
