<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MacSecondMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.MacSecondMonitor.Fullscreen.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowBackground">@color/stream_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <style name="Theme.MacSecondMonitor.Fullscreen" parent="Theme.MacSecondMonitor.Fullscreen.Base" />
</resources>
