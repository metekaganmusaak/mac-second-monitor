    "onboarding.connect.usb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبر USB (أقل زمن انتقال): وصّل جهازًا لوحيًا بنظام Android مع تفعيل تصحيح أخطاء USB. سيُفتح التطبيق على الجهاز اللوحي تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (geringste Latenz): Schließe ein Android-Tablet mit aktiviertem USB-Debugging an. Die App öffnet sich auf dem Tablet von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (lowest latency): connect an Android tablet with USB debugging enabled. The app opens on the tablet by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (menor latencia): conecta una tablet Android con la depuración por USB activada. La app se abre sola en la tablet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (latence minimale) : branchez une tablette Android avec le débogage USB activé. L’app s’ouvre automatiquement sur la tablette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (latenza minima): collega un tablet Android con il debug USB attivo. L’app si apre da sola sul tablet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USB（最小遅延）：USBデバッグを有効にしたAndroidタブレットを接続します。タブレットでAppが自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB(가장 낮은 지연 시간): USB 디버깅이 켜진 Android 태블릿을 연결하세요. 태블릿에서 앱이 자동으로 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (menor latência): conecte um tablet Android com a depuração USB ativada. O app abre sozinho no tablet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (минимальная задержка): подключите Android-планшет с включенной отладкой по USB. Приложение откроется на планшете само."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (en düşük gecikme): USB hata ayıklaması açık bir Android tableti bağlayın. Uygulama tablette kendiliğinden açılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB（延迟最低）：连接已开启 USB 调试的 Android 平板电脑。App 会在平板电脑上自动打开。"
          }
        }
      }
    },
    "onboarding.connect.wifi": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبر Wi-Fi: افتح تطبيق Mac Second Monitor على الجهاز، أو امسح رمز QR في القائمة لفتحه في المتصفح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: Öffne die App „Mac Second Monitor“ auf dem Gerät oder scanne den QR-Code im Menü und öffne ihn im Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: open the Mac Second Monitor app on the device, or scan the QR code in the menu with a browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: abre la app Mac Second Monitor en el dispositivo o escanea el código QR del menú para abrirlo en un navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi : ouvrez l’app Mac Second Monitor sur l’appareil, ou scannez le code QR du menu pour l’ouvrir dans un navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: apri l’app Mac Second Monitor sul dispositivo oppure scansiona il codice QR nel menu e aprilo in un browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi：デバイスでMac Second Monitor Appを開くか、メニューのQRコードをスキャンしてブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: 기기에서 Mac Second Monitor 앱을 열거나, 메뉴의 QR 코드를 스캔하여 브라우저에서 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: abra o app Mac Second Monitor no dispositivo ou escaneie o código QR do menu para abrir em um navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: откройте приложение Mac Second Monitor на устройстве или отсканируйте QR-код в меню и откройте его в браузере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: cihazda Mac Second Monitor uygulamasını açın ya da menüdeki QR kodunu bir tarayıcıyla tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi：在设备上打开 Mac Second Monitor App，或扫描菜单中的二维码，在浏览器中打开。"
          }
        }
      }
    },
