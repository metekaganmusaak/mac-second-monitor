{
  "sourceLanguage": "en",
  "strings": {
    "common.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "error.capture.displayNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display %ld is not available for capture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld numaralı ekran yakalama için kullanılamıyor."
          }
        }
      }
    },
    "error.capture.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording permission is required. Allow it in System Settings → Privacy & Security."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı izni gerekiyor. Sistem Ayarları → Gizlilik ve Güvenlik bölümünden izin verin."
          }
        }
      }
    },
    "error.encoder.create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video encoder could not be started (error %ld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video kodlayıcı başlatılamadı (hata %ld)."
          }
        }
      }
    },
    "error.encoder.encode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A frame could not be encoded (error %ld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kare kodlanamadı (hata %ld)."
          }
        }
      }
    },
    "error.pairing.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device is pairing with this Mac. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihaz bu Mac ile eşleşiyor. Biraz sonra tekrar deneyin."
          }
        }
      }
    },
    "error.pairing.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong pairing code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme kodu yanlış."
          }
        }
      }
    },
    "error.pairing.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong codes. Try again in %ld seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla yanlış kod girildi. %ld saniye sonra tekrar deneyin."
          }
        }
      }
    },
    "error.pairing.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing timed out. Connect again to get a new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme zaman aşımına uğradı. Yeni kod için tekrar bağlanın."
          }
        }
      }
    },
    "error.protocol.invalidMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device sent an invalid message."
