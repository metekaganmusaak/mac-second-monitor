    "settings.fps.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتجاوز معدل تحديث شاشة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie höher als die Bildwiederholrate des Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never higher than the device's screen refresh rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca supera la frecuencia de actualización de la pantalla del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais supérieure à la fréquence de rafraîchissement de l’écran de l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai superiore alla frequenza di aggiornamento dello schermo del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの画面のリフレッシュレートを超えることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 화면의 주사율보다 높아지지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca acima da taxa de atualização da tela do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выше частоты обновления экрана устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir zaman cihaz ekranının yenileme hızından yüksek olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会高于设备屏幕的刷新率。"
          }
        }
      }
    },
