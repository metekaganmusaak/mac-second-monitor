    "settings.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة المقترنة عبر Wi-Fi. يجب على الأجهزة المنسية إدخال رمز جديد. لا تحتاج أجهزة USB إلى الإقران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Wi-Fi gekoppelte Geräte. Entfernte Geräte müssen einen neuen Code eingeben. USB-Geräte müssen nie gekoppelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices paired over Wi-Fi. Forgotten devices must enter a new code. USB devices never need pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos vinculados por Wi-Fi. Los dispositivos olvidados deben introducir un código nuevo. Los dispositivos USB nunca necesitan vincularse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils jumelés via Wi-Fi. Un appareil oublié doit saisir un nouveau code. Les appareils USB n’ont jamais besoin d’être jumelés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivi abbinati tramite Wi-Fi. I dispositivi dimenticati devono inserire un nuovo codice. I dispositivi USB non richiedono mai l’abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi経由でペアリングしたデバイスです。登録を解除したデバイスは新しいコードの入力が必要です。USBデバイスはペアリング不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi로 페어링된 기기입니다. 지운 기기는 새 코드를 입력해야 합니다. USB 기기는 페어링이 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos emparelhados por Wi-Fi. Dispositivos esquecidos precisam digitar um novo código. Dispositivos USB nunca precisam de emparelhamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства, сопряженные по Wi-Fi. Забытым устройствам нужно ввести новый код. Устройствам USB сопряжение не требуется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi üzerinden eşleştirilmiş cihazlar. Unutulan cihazlar yeni bir kod girmelidir. USB cihazlarının eşleştirmeye ihtiyacı yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Wi-Fi 配对的设备。已忽略的设备必须重新输入配对码。USB 设备无需配对。"
          }
        }
      }
    },
