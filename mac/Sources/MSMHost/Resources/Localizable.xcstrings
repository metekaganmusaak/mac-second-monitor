    "permission.accessibility.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح التحكم في جهاز Mac هذا باللمس والقلم ولوحة المفاتيح على الجهاز. بدون هذا الإذن تعمل الشاشة لكنها تتجاهل الإدخال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht es, diesen Mac per Touch, Stift und Tastatur des Geräts zu steuern. Ohne diese Berechtigung funktioniert das Display, ignoriert aber Eingaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets touches, the stylus and the keyboard on the device control this Mac. Without it the display works but ignores input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite controlar este Mac con la pantalla táctil, el lápiz y el teclado del dispositivo. Sin este permiso, la pantalla funciona pero ignora las entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de contrôler ce Mac avec l’écran tactile, le stylet et le clavier de l’appareil. Sans cette autorisation, l’écran fonctionne mais ignore les saisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di controllare questo Mac con il tocco, la penna e la tastiera del dispositivo. Senza questa autorizzazione lo schermo funziona ma ignora l’input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのタッチ、スタイラス、キーボードでこのMacを操作できるようにします。許可しなくてもディスプレイは使えますが、入力は無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 터치, 스타일러스, 키보드로 이 Mac을 제어할 수 있게 합니다. 허용하지 않으면 디스플레이는 작동하지만 입력은 무시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o toque, a caneta e o teclado do dispositivo controlem este Mac. Sem isso, a tela funciona, mas ignora as entradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет управлять этим Mac касаниями, стилусом и клавиатурой устройства. Без этого разрешения монитор работает, но не реагирует на ввод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazdaki dokunma, kalem ve klavyenin bu Mac’i kontrol etmesini sağlar. Bu izin olmadan ekran çalışır ama girişler yok sayılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通过设备上的触控、触控笔和键盘控制此 Mac。未授权时显示器仍可使用，但会忽略输入。"
          }
        }
      }
    },
