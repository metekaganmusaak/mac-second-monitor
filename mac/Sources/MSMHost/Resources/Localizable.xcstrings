    "onboarding.connect.usb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (lowest latency): connect an Android tablet with USB debugging enabled. The app opens on the tablet by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "USB (en düşük gecikme): USB hata ayıklaması açık bir Android tableti bağlayın. Uygulama tablette kendiliğinden açılır."
          }
        }
      }
    },
    "onboarding.connect.wifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: open the Mac Second Monitor app on the device, or scan the QR code in the menu with a browser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: cihazda Mac Second Monitor uygulamasını açın ya da menüdeki QR kodunu bir tarayıcıyla tarayın."
          }
        }
      }
    },
