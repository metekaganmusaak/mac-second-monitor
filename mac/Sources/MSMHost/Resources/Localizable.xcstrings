          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось закодировать кадр (ошибка %ld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kare kodlanamadı (hata %ld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法编码某一帧（错误 %ld）。"
          }
        }
      }
    },
    "error.pairing.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري إقران جهاز آخر بجهاز Mac هذا. أعد المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät wird gerade mit diesem Mac gekoppelt. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device is pairing with this Mac. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo se está vinculando con este Mac. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil est en cours de jumelage avec ce Mac. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo si sta abbinando a questo Mac. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスがこのMacとペアリング中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기가 이 Mac과 페어링하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo está sendo emparelhado com este Mac. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство уже выполняет сопряжение с этим Mac. Повторите попытку чуть позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihaz bu Mac ile eşleşiyor. Biraz sonra tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备正在与此 Mac 配对。请稍后再试。"
          }
        }
      }
    },
    "error.pairing.failed": {
      "extractionState": "manual",
      "localizations": {
