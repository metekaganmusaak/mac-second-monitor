    "settings.hevc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفضيل HEVC عندما يدعمه الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEVC bevorzugen, wenn das Gerät es unterstützt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer HEVC when the device supports it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferir HEVC si el dispositivo lo admite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégier HEVC si l’appareil le prend en charge"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci HEVC se il dispositivo lo supporta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが対応している場合はHEVCを優先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 지원하면 HEVC 우선 사용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferir HEVC quando o dispositivo for compatível"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитать HEVC, если устройство его поддерживает"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz destekliyorsa HEVC tercih et"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备支持时优先使用 HEVC"
          }
        }
      }
    },
    "settings.hevc.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة أوضح بمعدل البت نفسه؛ ويوفّر H.264 زمن انتقال أقل قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schärfer bei gleicher Bitrate; H.264 hat eine etwas geringere Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharper at the same bitrate; H.264 has slightly lower latency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más nítido con la misma tasa de bits; H.264 tiene algo menos de latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus net à débit égal ; H.264 offre une latence légèrement plus faible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più nitido a parità di bitrate; H.264 ha una latenza leggermente inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じビットレートでより鮮明です。H.264は遅延がわずかに少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 비트레이트에서 더 선명합니다. H.264는 지연 시간이 약간 더 짧습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais nítido com a mesma taxa de bits; o H.264 tem latência um pouco menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четче при том же битрейте; у H.264 задержка немного ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı bit hızında daha net; H.264’ün gecikmesi biraz daha düşüktür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同码率下画面更清晰；H.264 的延迟略低。"
          }
        }
      }
    },
