    "error.capture.displayNotFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشة العرض %ld غير متاحة للالتقاط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display %ld ist für die Aufnahme nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display %ld is not available for capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla %ld no está disponible para la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran %ld n’est pas disponible pour la capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo %ld non è disponibile per l’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイ%ldはキャプチャに使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 %ld번을 캡처할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela %ld não está disponível para captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Монитор %ld недоступен для захвата."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld numaralı ekran yakalama için kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器 %ld 无法用于捕获。"
          }
        }
      }
    },
    "error.capture.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إذن «تسجيل الشاشة». اسمح به من إعدادات النظام ← الخصوصية والأمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung „Bildschirmaufnahme“ ist erforderlich. Erlaube sie unter Systemeinstellungen → Datenschutz & Sicherheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording permission is required. Allow it in System Settings → Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita el permiso de Grabación de pantalla. Actívalo en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Enregistrement de l’écran est requise. Accordez-la dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessaria l’autorizzazione Registrazione schermo. Concedila in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画面収録」の許可が必要です。「システム設定」→「プライバシーとセキュリティ」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'화면 기록' 권한이 필요합니다. 시스템 설정 → 개인정보 보호 및 보안에서 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária a permissão de Gravação de Tela. Permita em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение «Запись экрана». Разрешите его здесь: Системные настройки → Конфиденциальность и безопасность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı izni gerekiyor. Sistem Ayarları → Gizlilik ve Güvenlik bölümünden izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要“屏幕录制”权限。请在“系统设置”→“隐私与安全性”中允许。"
          }
        }
      }
    },
    "error.encoder.create": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل مُرمِّز الفيديو (الخطأ %ld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Video-Encoder konnte nicht gestartet werden (Fehler %ld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video encoder could not be started (error %ld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar el codificador de vídeo (error %ld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer l’encodeur vidéo (erreur %ld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare l’encoder video (errore %ld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオエンコーダを起動できませんでした（エラー%ld）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 인코더를 시작할 수 없습니다(오류 %ld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o codificador de vídeo (erro %ld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить видеокодер (ошибка %ld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video kodlayıcı başlatılamadı (hata %ld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动视频编码器（错误 %ld）。"
          }
        }
      }
    },
    "error.encoder.encode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
