    "settings.usb.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتصل أجهزة Android عبر USB من خلال adb (أدوات منصة Android) عند تفعيل تصحيح أخطاء USB على الجهاز. اترك المسار فارغًا للعثور على adb تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Geräte verbinden sich per USB über adb (Android Platform Tools), wenn auf dem Gerät USB-Debugging aktiviert ist. Lass den Pfad leer, um adb automatisch zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android devices connect over USB through adb (Android platform tools) with USB debugging enabled on the device. Leave the path empty to find adb automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos Android se conectan por USB mediante adb (Android Platform Tools) con la depuración por USB activada en el dispositivo. Deja la ruta vacía para buscar adb automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils Android se connectent en USB via adb (Android Platform Tools) lorsque le débogage USB est activé sur l’appareil. Laissez le chemin vide pour trouver adb automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi Android si connettono via USB tramite adb (Android Platform Tools) con il debug USB attivo sul dispositivo. Lascia vuoto il percorso per trovare adb automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidデバイスは、デバイスでUSBデバッグを有効にすると、adb（Android Platform Tools）経由でUSB接続されます。パスを空欄にするとadbを自動的に検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 기기는 USB 디버깅이 켜져 있으면 adb(Android 플랫폼 도구)를 통해 USB로 연결됩니다. 경로를 비워 두면 adb를 자동으로 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos Android se conectam por USB via adb (Android Platform Tools) com a depuração USB ativada no dispositivo. Deixe o caminho vazio para encontrar o adb automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства Android подключаются по USB через adb (Android Platform Tools), если на устройстве включена отладка по USB. Оставьте путь пустым, чтобы найти adb автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cihazlar, cihazda USB hata ayıklaması açıkken adb (Android platform araçları) üzerinden USB ile bağlanır. adb’yi otomatik bulmak için yolu boş bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 设备开启 USB 调试后，可通过 adb（Android 平台工具）经 USB 连接。将路径留空即可自动查找 adb。"
          }
        }
      }
    },
