    "usb.adb.notFoundHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام USB، ثبّت أدوات منصة Android: brew install android-platform-tools"
          }
        },
