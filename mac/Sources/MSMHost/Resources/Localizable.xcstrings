    "pairing.notification.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل %@ على الجهاز لإقرانه بجهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib %@ auf dem Gerät ein, um es mit diesem Mac zu koppeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter %@ on the device to pair it with this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce %@ en el dispositivo para vincularlo con este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez %@ sur l’appareil pour le jumeler avec ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci %@ sul dispositivo per abbinarlo a questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacとペアリングするには、デバイスで%@と入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac과 페어링하려면 기기에 %@ 코드를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite %@ no dispositivo para emparelhá-lo com este Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите %@ на устройстве, чтобы выполнить сопряжение с этим Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac ile eşleştirmek için cihaza %@ kodunu girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上输入 %@，即可将其与此 Mac 配对。"
          }
        }
      }
    },
