    "settings.requirePairing.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب على الأجهزة الجديدة على الشبكة إدخال رمز يظهر على جهاز Mac هذا. لا تُوقف هذا الخيار إلا على شبكات تثق بها تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Geräte im Netzwerk müssen einen Code eingeben, der auf diesem Mac angezeigt wird. Deaktiviere dies nur in Netzwerken, denen du voll vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New devices on the network must enter a code shown on this Mac. Turn off only on networks you fully trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos nuevos de la red deben introducir un código que se muestra en este Mac. Desactívalo solo en redes de total confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux appareils du réseau doivent saisir un code affiché sur ce Mac. Ne désactivez cette option que sur des réseaux entièrement fiables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi dispositivi sulla rete devono inserire un codice mostrato su questo Mac. Disattiva solo su reti di cui ti fidi completamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク上の新しいデバイスは、このMacに表示されるコードを入力する必要があります。完全に信頼できるネットワークでのみオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크의 새 기기는 이 Mac에 표시된 코드를 입력해야 합니다. 완전히 신뢰하는 네트워크에서만 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos dispositivos na rede precisam digitar um código exibido neste Mac. Desative apenas em redes totalmente confiáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые устройства в сети должны ввести код, показанный на этом Mac. Отключайте только в сетях, которым полностью доверяете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağdaki yeni cihazlar bu Mac’te gösterilen kodu girmelidir. Yalnızca tamamen güvendiğiniz ağlarda kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络中的新设备必须输入此 Mac 上显示的配对码。请仅在完全信任的网络中关闭此选项。"
          }
        }
      }
    },
