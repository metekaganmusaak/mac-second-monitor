    "permission.screenRecording.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للتطبيق التقاط الشاشة الإضافية وإرسالها إلى الجهاز. لا يتم تسجيل أي شيء أو حفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht der App, das zusätzliche Display aufzunehmen und an das Gerät zu senden. Es wird nichts aufgezeichnet oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app capture the extra display and send it to the device. Nothing is recorded or stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la app capture la pantalla adicional y la envíe al dispositivo. No se graba ni se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l’app de capturer l’écran supplémentaire et de l’envoyer à l’appareil. Rien n’est enregistré ni conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente all’app di acquisire lo schermo aggiuntivo e di inviarlo al dispositivo. Non viene registrato né salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appが追加ディスプレイをキャプチャしてデバイスに送信できるようにします。録画や保存は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 추가 디스플레이를 캡처하여 기기로 보낼 수 있게 합니다. 아무것도 녹화하거나 저장하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o app capture a tela extra e a envie ao dispositivo. Nada é gravado nem armazenado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет приложению захватывать дополнительный монитор и передавать изображение на устройство. Ничего не записывается и не сохраняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın ek ekranı yakalayıp cihaza göndermesini sağlar. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 App 捕获额外显示器的画面并发送到设备。不会录制或存储任何内容。"
          }
        }
      }
    },
    "permission.screenRecording.short": {
