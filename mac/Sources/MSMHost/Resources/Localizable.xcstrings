            "value": "Wrong pairing code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de vinculación incorrecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de jumelage incorrect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice di abbinamento errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードが正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드가 올바르지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de emparelhamento incorreto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный код сопряжения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme kodu yanlış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码错误。"
          }
        }
      }
    },
    "error.pairing.locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إدخال رموز خاطئة كثيرة. أعد المحاولة بعد %ld ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele falsche Codes. Versuche es in %ld Sekunden erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong codes. Try again in %ld seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados códigos incorrectos. Inténtalo de nuevo en %ld segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de codes incorrects. Réessayez dans %ld secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi codici errati. Riprova tra %ld secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違ったコードが多すぎます。%ld秒後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 코드를 너무 많이 입력했습니다. %ld초 후에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos códigos incorretos. Tente novamente em %ld segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных кодов. Повторите попытку через %ld с."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla yanlış kod girildi. %ld saniye sonra tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误次数过多。请在 %ld 秒后重试。"
          }
        }
      }
    },
    "error.pairing.timeout": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة الإقران. اتصل مجددًا للحصول على رمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Koppeln. Verbinde erneut, um einen neuen Code zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing timed out. Connect again to get a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el tiempo de vinculación. Vuelve a conectarte para obtener un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de jumelage a expiré. Reconnectez-vous pour obtenir un nouveau code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo scaduto per l’abbinamento. Connettiti di nuovo per ricevere un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングがタイムアウトしました。もう一度接続して新しいコードを取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 시간이 초과되었습니다. 다시 연결하여 새 코드를 받으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de emparelhamento esgotou. Conecte-se novamente para receber um novo código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время сопряжения истекло. Подключитесь снова, чтобы получить новый код."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme zaman aşımına uğradı. Yeni kod için tekrar bağlanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已超时。请重新连接以获取新的配对码。"
          }
        }
      }
    },
    "error.protocol.invalidMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الجهاز رسالة غير صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät hat eine ungültige Nachricht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device sent an invalid message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo ha enviado un mensaje no válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil a envoyé un message non valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo ha inviato un messaggio non valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスから無効なメッセージが送信されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 유효하지 않은 메시지를 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo enviou uma mensagem inválida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство отправило недопустимое сообщение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz geçersiz bir mesaj gönderdi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备发送了无效的消息。"
          }
        }
      }
    },
    "error.protocol.resolution": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ الجهاز عن حجم شاشة غير مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät hat eine nicht unterstützte Bildschirmgröße gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device reported an unsupported screen size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo ha indicado un tamaño de pantalla no compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil a signalé une taille d’écran non prise en charge."
          }
