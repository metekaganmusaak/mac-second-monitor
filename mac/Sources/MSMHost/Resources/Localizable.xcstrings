    "onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم جهازًا لوحيًا أو هاتفًا أو كمبيوتر كشاشة عرض لجهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze ein Tablet, Smartphone oder einen Computer als Display für diesen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tablet, phone or computer as a display for this Mac."
          }
        },
        "es": {
