    "menu.web.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز بأي هاتف أو جهاز لوحي أو كمبيوتر على هذه الشبكة لفتح عميل المتصفح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code mit einem Smartphone, Tablet oder Computer in diesem Netzwerk, um den Browser-Client zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with any phone, tablet or computer on this network to open the browser client."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanéalo con cualquier teléfono, tablet u ordenador de esta red para abrir el cliente web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez-le avec un téléphone, une tablette ou un ordinateur de ce réseau pour ouvrir le client web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona con un telefono, tablet o computer su questa rete per aprire il client web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワーク上のスマートフォン、タブレット、コンピュータでスキャンすると、ブラウザクライアントが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크에 있는 휴대폰, 태블릿 또는 컴퓨터로 스캔하면 브라우저 클라이언트가 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie com qualquer celular, tablet ou computador nesta rede para abrir o cliente web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код телефоном, планшетом или компьютером в этой сети, чтобы открыть веб-клиент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı istemcisini açmak için bu ağdaki herhangi bir telefon, tablet veya bilgisayarla tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此网络中的任意手机、平板电脑或电脑扫描，即可打开浏览器客户端。"
          }
        }
      }
    },
